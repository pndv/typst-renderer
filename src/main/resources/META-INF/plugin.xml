<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.pndv.typstrenderer</id>
    <name>Typst</name>
    <vendor>pndv</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <!-- JCEF is a separate bundled plugin from 2026.2 (build 262) onwards; the embedded PDF
         preview (TypstFilePreviewer) needs com.intellij.ui.jcef.* and org.cef.* from it. Without
         this dependency the plugin classloader cannot see JBCefApp and the previewer dies with a
         NoClassDefFoundError on 262. -->
    <depends>com.intellij.modules.jcef</depends>

    <resource-bundle>messages.TypstBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Typst file type -->
        <fileType
                name="Typst"
                implementationClass="com.github.pndv.typstrenderer.language.TypstFileType"
                fieldName="INSTANCE"
                language="Typst"
                extensions="typ"/>

        <!-- Minimal parser definition (binds .typ files to TypstLanguage at the PSI level) -->
        <lang.parserDefinition language="Typst"
                               implementationClass="com.github.pndv.typstrenderer.language.TypstParserDefinition"/>

        <!-- Syntax highlighter (provides token boundaries for LSP semantic-token overlay) -->
        <lang.syntaxHighlighterFactory language="Typst"
                                       implementationClass="com.github.pndv.typstrenderer.language.TypstSyntaxHighlighterFactory"/>

        <!-- Comment toggling (Ctrl+/ and Ctrl+Shift+/) -->
        <lang.commenter language="Typst"
                        implementationClass="com.github.pndv.typstrenderer.language.TypstCommenter"/>

        <!-- LSP support via tinymist -->
        <platform.lsp.integrationProvider
                implementation="com.github.pndv.typstrenderer.lsp.TinymistLspServerSupportProvider"/>

        <!-- LSP for .typ files outside the project content roots: the platform gates the
             integrationProvider's fileOpened on ProjectFileIndex.isInContent, so standalone
             documents need their own startup sweep (see TypstExternalFileLspStarter). -->
        <postStartupActivity
                implementation="com.github.pndv.typstrenderer.lsp.TypstExternalFileLspStartupActivity"/>

        <!-- Symbol rename via LSP (IntelliJ's LSP module does not support textDocument/rename).
             Editor-only by design: file rename has no caret to resolve a symbol from, so this
             handler declines editor-less contexts and lets the platform's own handler rename
             the file. Claiming them instead makes file rename a silent no-op, because the
             platform only falls back to its default handler when nothing else claims. -->
        <renameHandler implementation="com.github.pndv.typstrenderer.lsp.TypstLspRenameHandler"
                       id="TypstLspRenameHandler" order="first"/>

        <!-- File rename: the platform moves the file, tinymist supplies the import rewrites.
             Must be order="first" — RenameProcessor.performRefactoring dispatches renameElement to
             the *first* processor whose canProcessElement matches, so a later position would let
             the platform's own RenamePsiFileProcessor answer instead and the imports would go
             stale. prepareRenaming, by contrast, runs on every matching processor. -->
        <renamePsiElementProcessor implementation="com.github.pndv.typstrenderer.lsp.TypstRenameFileProcessor"
                                   id="TypstRenameFileProcessor" order="first"/>


        <!-- Settings -->
        <applicationConfigurable
                parentId="tools"
                instance="com.github.pndv.typstrenderer.settings.TypstSettingsConfigurable"
                id="com.github.pndv.typstrenderer.settings.TypstSettingsConfigurable"
                bundle="messages.TypstBundle" key="settings.displayName" />
        <projectConfigurable
                parentId="com.github.pndv.typstrenderer.settings.TypstSettingsConfigurable"
                instance="com.github.pndv.typstrenderer.settings.TypstProjectSettingsConfigurable"
                id="com.github.pndv.typstrenderer.settings.TypstProjectSettingsConfigurable"
                bundle="messages.TypstBundle" key="settings.project.displayName" />


        <!-- Tool window for compilation output -->
        <toolWindow
                id="Typst Output"
                anchor="bottom"
                factoryClass="com.github.pndv.typstrenderer.toolWindow.TypstOutputToolWindowFactory"
                icon="AllIcons.Toolwindows.ToolWindowMessages"/>

        <!-- Split editor with live PDF preview -->
        <fileEditorProvider
                implementation="com.github.pndv.typstrenderer.editor.TypstSplitEditorProvider"/>

        <!-- Notifications -->
        <notificationGroup id="Typst" displayType="BALLOON" bundle="messages.TypstBundle"
                           key="notification.group.typst"/>

        <!-- HTTP server for PDF.js viewer assets (served to the embedded JCEF browser
             via IntelliJ's built-in Netty server, namespaced under /typst-renderer-*). -->
        <httpRequestHandler
                implementation="com.github.pndv.typstrenderer.editor.PdfjsPreviewServer"/>
    </extensions>

    <projectListeners>
        <!-- Editor-open hook for out-of-content .typ files — the platform's own LSP
             file-open dispatch never reaches the integrationProvider for them. -->
        <listener class="com.github.pndv.typstrenderer.lsp.TypstExternalFileLspStarter"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <action id="Typst.Compile"
                class="com.github.pndv.typstrenderer.actions.TypstCompileAction"
                icon="AllIcons.Actions.Execute">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift T"/>
        </action>

        <action id="Typst.PinMainFile"
                class="com.github.pndv.typstrenderer.actions.TypstPinMainFileAction"
                icon="AllIcons.Nodes.Favorite">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Typst.Compile"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Typst.Compile"/>
        </action>

        <action id="Typst.UnpinMainFile"
                class="com.github.pndv.typstrenderer.actions.TypstUnpinMainFileAction"
                icon="AllIcons.Nodes.NotFavoriteOnHover">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Typst.PinMainFile"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="Typst.PinMainFile"/>
        </action>

        <!-- Also constructed directly by TypstSplitEditor for its preview toolbar. Registered
             here as well so it is findable in Search Everywhere / Find Action and can be given
             a keyboard shortcut; that copy resolves the pane from the focused editor. -->
        <action id="Typst.TogglePreviewMode"
                class="com.github.pndv.typstrenderer.actions.TypstTogglePreviewModeAction"
                icon="AllIcons.Actions.Lightning">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="Typst.UnpinMainFile"/>
        </action>

        <!-- Attached as a left-edge toolbar, the toolbar is then set to SimpleToolWindowPanel.
             Registered here (rather than created inline in the factory) so they're discoverable from the action search
             palette and can be assigned keyboard shortcuts by the user. -->
        <action id="Typst.RecompileFromOutput"
                class="com.github.pndv.typstrenderer.actions.TypstRecompileFromOutputAction"
                icon="AllIcons.Actions.Execute"/>
        <action id="Typst.ClearOutputConsole"
                class="com.github.pndv.typstrenderer.actions.TypstClearOutputConsoleAction"
                icon="AllIcons.Actions.GC"/>
        <action id="Typst.ScrollOutputToEnd"
                class="com.github.pndv.typstrenderer.actions.TypstScrollOutputToEndAction"
                icon="AllIcons.RunConfigurations.Scroll_down"/>
    </actions>
</idea-plugin>
